# Server Port
PORT=5001

# MongoDB Connection String (Local or MongoDB Atlas Cloud)
# For Local Mongo: mongodb://localhost:27017/healthylife (or mongodb://mongo:27017/healthylife in docker network)
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/healthylife?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/healthylife

# JWT Secret Key
JWT_SECRET=healthylife_jwt_secret_key_super_secure_2026

# Environment
NODE_ENV=production
APP_TIMEZONE=Asia/Jakarta
