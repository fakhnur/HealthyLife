# Copy to .env (or .env.local) and adjust as needed. Never commit .env.

# Backend origin for the Vite dev-server proxy on /api.
# Read by Node in vite.config.js (process.env), so it is NOT inlined into the
# browser bundle and does not need the VITE_ prefix for security reasons.
VITE_BACKEND_URL=http://127.0.0.1:5001

# For Netlify deployment, set BACKEND_URL in Netlify Dashboard Environment Variables:
# BACKEND_URL=http://<YOUR_VPS_IP>:5001

# Axios baseURL for the SPA (src/services/api.js).
# Keep "/api" to use the Vite dev proxy locally and the Nginx /api reverse
# proxy in Docker/production. Set an absolute URL only for split deployments.
VITE_API_URL=/api
